From 0ff1bcd9cedcc11b7c03a813bacb767d0cc6a503 Mon Sep 17 00:00:00 2001
From: Giulio Benetti <giulio.benetti@benettiengineering.com>
Date: Fri, 6 Nov 2026 16:17:08 +0100
Subject: [PATCH 38/38] Fix build with Linux 7.1

Commit:
https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=52a9e9cd181fab8b03cf4e982533224697669976
renames zap_vma_ptes() to zap_special_vma_range() so let's call
zap_special_vma_range() when Linux version is 7.1.0 or later.

Signed-off-by: Giulio Benetti <giulio.benetti@benettiengineering.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/devicedrv/mali/linux/mali_memory_cow.c     | 8 ++++++++
 src/devicedrv/mali/linux/mali_memory_manager.c | 4 ++++
 2 files changed, 12 insertions(+)

diff --git a/src/devicedrv/mali/linux/mali_memory_cow.c b/src/devicedrv/mali/linux/mali_memory_cow.c
index d6f5a16..968a98d 100755
--- a/src/devicedrv/mali/linux/mali_memory_cow.c
+++ b/src/devicedrv/mali/linux/mali_memory_cow.c
@@ -381,7 +381,11 @@ _mali_osk_errcode_t mali_memory_cow_modify_range(mali_mem_backend *backend,
 		MALI_DEBUG_ASSERT(alloc->cpu_mapping.vma->vm_end - alloc->cpu_mapping.vma->vm_start >= range_size);
 
 		if (MALI_MEM_BACKEND_FLAG_SWAP_COWED != (backend->flags & MALI_MEM_BACKEND_FLAG_SWAP_COWED)) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+			zap_special_vma_range(alloc->cpu_mapping.vma, alloc->cpu_mapping.vma->vm_start + range_start, range_size);
+#else
 			zap_vma_ptes(alloc->cpu_mapping.vma, alloc->cpu_mapping.vma->vm_start + range_start, range_size);
+#endif
 
 			ret = mali_mem_cow_cpu_map_pages_locked(backend, alloc->cpu_mapping.vma, alloc->cpu_mapping.vma->vm_start  + range_start, range_size / _MALI_OSK_MALI_PAGE_SIZE);
 
@@ -398,7 +402,11 @@ _mali_osk_errcode_t mali_memory_cow_modify_range(mali_mem_backend *backend,
 			alloc->cpu_mapping.vma->vm_flags |= VM_MIXEDMAP;
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+			zap_special_vma_range(alloc->cpu_mapping.vma, alloc->cpu_mapping.vma->vm_start + range_start, range_size);
+#else
 			zap_vma_ptes(alloc->cpu_mapping.vma, alloc->cpu_mapping.vma->vm_start + range_start, range_size);
+#endif
 			/* delete this flag to let swappble is ummapped regard to stauct page not page frame. */
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
 			vm_flags_clear(alloc->cpu_mapping.vma, VM_PFNMAP | VM_MIXEDMAP);
diff --git a/src/devicedrv/mali/linux/mali_memory_manager.c b/src/devicedrv/mali/linux/mali_memory_manager.c
index 814eb7f..d352434 100755
--- a/src/devicedrv/mali/linux/mali_memory_manager.c
+++ b/src/devicedrv/mali/linux/mali_memory_manager.c
@@ -308,7 +308,11 @@ static _mali_osk_errcode_t mali_mem_resize(struct mali_session_data *session, ma
 		/* Zap cpu mapping */
 		if (0 != mali_allocation->cpu_mapping.addr) {
 			MALI_DEBUG_ASSERT(NULL != mali_allocation->cpu_mapping.vma);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+			zap_special_vma_range(mali_allocation->cpu_mapping.vma, mali_allocation->cpu_mapping.vma->vm_start + physical_size, dec_size);
+#else
 			zap_vma_ptes(mali_allocation->cpu_mapping.vma, mali_allocation->cpu_mapping.vma->vm_start + physical_size, dec_size);
+#endif
 		}
 
 		/* Free those extra pages */
-- 
2.47.3

