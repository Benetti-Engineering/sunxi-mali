From e6e703c7046bc9a86bb07cda518bd07d31b3bea3 Mon Sep 17 00:00:00 2001
From: Giulio Benetti <giulio.benetti@benettiengineering.com>
Date: Fri, 6 Nov 2026 16:17:42 +0100
Subject: [PATCH] Fix build with Linux 7.2

Commit:
https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=d4c14903bf5e28e740516c4fbb7db01e0dedf3af
drops the signal_on_any argument of dma_fence_array_create() so let's not
pass it when Linux version is 7.2.0 or later. It was always false here,
which is the only behaviour left in the kernel.

Signed-off-by: Giulio Benetti <giulio.benetti@benettiengineering.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/devicedrv/mali/linux/mali_internal_sync.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/devicedrv/mali/linux/mali_internal_sync.c b/src/devicedrv/mali/linux/mali_internal_sync.c
index 0c74391..55cc5f9 100644
--- a/src/devicedrv/mali/linux/mali_internal_sync.c
+++ b/src/devicedrv/mali/linux/mali_internal_sync.c
@@ -401,6 +401,9 @@ static int mali_internal_sync_fence_set_fence_array(struct mali_internal_sync_fe
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0)
 	array = fence_array_create(num_fences, fences,
 				   fence_context_alloc(1), 1, false);
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+	array = dma_fence_array_create(num_fences, fences,
+				       dma_fence_context_alloc(1), 1);
 #else
 	array = dma_fence_array_create(num_fences, fences,
 				       dma_fence_context_alloc(1), 1, false);
-- 
